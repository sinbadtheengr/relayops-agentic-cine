# --- Gemini access (pick ONE option) ---

# Option A: Google AI Studio API key (fastest way to start)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key

# Option B: Vertex AI (use for final submission — hackathon runs on Google Cloud)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Parallel track requirement: Search API called at runtime ---
PARALLEL_API_KEY=your-parallel-api-key

# --- Optional overrides ---
# REELRELAY_MODEL=gemini-2.5-flash
